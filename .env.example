# Salin ke .env (sudah di .gitignore). Isi lewat: python scripts/login.py
# JANGAN commit file .env.

# Reddit API (tipe "script") — https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Browser tempat kamu login IG / X / FB. Cookie-nya dibaca langsung oleh
# yt-dlp, gallery-dl, dan instaloader — tidak pernah disalin ke repo.
# Pilihan: firefox (paling stabil), chrome, edge, brave
COOKIE_BROWSER=firefox

# Username akun Instagram yang dipakai login (disarankan akun sekunder khusus riset)
INSTAGRAM_USERNAME=
